        "group": "slab",
        "since": "10.0.0",
        "arity": -2,
        "function": "slflushCommand",
        "command_flags": [
            "ADMIN",
            "BLOCKING"
        ],
        "acl_categories": [
            "SLAB",
            "ADMIN",
            "DANGEROUS",
            "BLOCKING",
            "SLOW"
        ],
        "key_specs": [
            {
                "flags": [
                    "RO"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
